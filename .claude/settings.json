{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(chmod:*)",
      "Bash(bash:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rm -rf ~/Library/Developer/Xcode/DerivedData:*)",
      "mcp__argent"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__argent__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/gennadiyfurduy/.claude/hooks/argent-sim-gate.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/gennadiyfurduy/.claude/hooks/worktree-gate.py\"",
            "timeout": 15,
            "statusMessage": "Checking branch/worktree..."
          },
          {
            "type": "command",
            "command": "python3 \"/Users/gennadiyfurduy/.claude/hooks/repro-gate.py\"",
            "timeout": 60,
            "statusMessage": "Checking bug reproduction..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/gennadiyfurduy/.claude/hooks/goal-report-gate.py\"",
            "timeout": 15,
            "statusMessage": "Checking goal report..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/gennadiyfurduy/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/gennadiyfurduy/.claude/skills/argent-ephemeral-simulator/scripts/cleanup-ephemeral-sims.sh\" --gc",
            "timeout": 60,
            "statusMessage": "GC of leaked ephemeral simulators...",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/gennadiyfurduy/.claude/skills/argent-ephemeral-simulator/scripts/cleanup-ephemeral-sims.sh\"",
            "timeout": 60,
            "statusMessage": "Cleaning up ephemeral simulators..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/gennadiyfurduy/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ai-mt": {
      "source": {
        "source": "directory",
        "path": "/Users/gennadiyfurduy/ratel/ai-mt"
      }
    }
  },
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}